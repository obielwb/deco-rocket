{
	"scopeName": "deco",
	"name": "deco-rocket",
	"friendlyName": "Deco Rocket",
	"description": "Agentic product research: mines multi-source market trends, cross-references the store's VTEX catalog for whitespace, scores opportunities, and generates product concepts, supplier cost, hero images and copy — as a Product Opportunity Report.",
	"icon": "",
	"connection": {
		"type": "HTTP",
		"url": "https://your-app.decocache.com/api/mcp",
		"configSchema": {
			"type": "object",
			"properties": {
				"SERPAPI_KEY": { "type": "string", "title": "SerpApi API key" },
				"DATAFORSEO_LOGIN": { "type": "string", "title": "DataForSEO login" },
				"DATAFORSEO_PASSWORD": {
					"type": "string",
					"title": "DataForSEO password"
				},
				"ANTHROPIC_API_KEY": { "type": "string", "title": "Anthropic API key" },
				"ANTHROPIC_MODEL": {
					"type": "string",
					"title": "Anthropic model",
					"default": "claude-sonnet-5"
				},
				"IMAGE_PROVIDER": {
					"type": "string",
					"enum": ["gemini", "openai"],
					"default": "gemini"
				},
				"GEMINI_API_KEY": { "type": "string", "title": "Gemini API key" },
				"OPENAI_API_KEY": { "type": "string", "title": "OpenAI API key" },
				"VTEX_ACCOUNT": { "type": "string", "title": "VTEX account" },
				"VTEX_APP_KEY": { "type": "string", "title": "VTEX app key" },
				"VTEX_APP_TOKEN": { "type": "string", "title": "VTEX app token" },
				"VTEX_ENVIRONMENT": {
					"type": "string",
					"default": "vtexcommercestable"
				},
				"RESEND_API_KEY": {
					"type": "string",
					"title": "Resend API key (RFQ e-mails)"
				},
				"RFQ_FROM_EMAIL": {
					"type": "string",
					"title": "RFQ sender e-mail (verified)"
				},
				"RFQ_FROM_NAME": {
					"type": "string",
					"default": "Equipe de Compras"
				},
				"RFQ_INBOUND_DOMAIN": {
					"type": "string",
					"title": "Inbound domain for reply correlation"
				},
				"RFQ_WEBHOOK_SECRET": {
					"type": "string",
					"title": "Inbound webhook shared secret"
				},
				"GEO": { "type": "string", "default": "BR" },
				"LANG": { "type": "string", "default": "pt-BR" }
			},
			"required": []
		}
	},
	"unlisted": true,
	"metadata": {
		"categories": ["commerce", "research", "ai"],
		"official": false,
		"tags": ["ecommerce", "product-research", "trends", "vtex", "mcp-app"],
		"short_description": "Find your next product with data — trends, whitespace, concept, image & copy."
	}
}
