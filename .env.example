# Deco Research — credentials (copy to `.env`, fill what you have).
# Every provider is optional; each tool degrades gracefully when its key is absent.

# --- Trend intelligence ---
# SerpApi (Google Trends + Google Shopping) — https://serpapi.com
SERPAPI_KEY=

# DataForSEO (keyword search volume) — https://dataforseo.com
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- LLM (concept + copy) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Image generation ---
IMAGE_PROVIDER=gemini            # gemini | openai
GEMINI_API_KEY=                  # Google AI Studio (nano-banana / gemini-2.5-flash-image)
OPENAI_API_KEY=                  # gpt-image-1

# --- Store catalog (VTEX) ---
VTEX_ACCOUNT=
VTEX_APP_KEY=
VTEX_APP_TOKEN=
VTEX_ENVIRONMENT=vtexcommercestable

# --- RFQ Agent (supplier quote e-mails via Resend) ---
RESEND_API_KEY=                  # https://resend.com
RFQ_FROM_EMAIL=                  # verified sender, e.g. compras@sualoja.com
RFQ_FROM_NAME=Equipe de Compras
RFQ_INBOUND_DOMAIN=              # optional, for reply plus-addressing (rfq+<id>@rfq.sualoja.com)
RFQ_WEBHOOK_SECRET=              # shared secret to authenticate the inbound webhook

# --- Localization ---
GEO=BR
LANG=pt-BR
